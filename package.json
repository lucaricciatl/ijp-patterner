{
  "name": "ijp-patterner",
  "version": "1.0.3",
  "description": "Visual editor for .ptn inkjet deposition pattern files",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify-ptn.mjs",
    "dist": "npm run build && electron-builder --mac --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never"
  },
  "license": "MIT",
  "type": "commonjs",
  "productName": "IJP Patterner",
  "private": "true",
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.4.0"
  },
  "build": {
    "appId": "com.lucaricci.ijppatterner",
    "productName": "IJP Patterner",
    "copyright": "Luca Ricci",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "darkModeSupport": true,
      "artifactName": "${productName} ${version} ${arch}.${ext}"
    },
    "dmg": {
      "title": "IJP Patterner",
      "contents": [
        {
          "x": 140,
          "y": 200
        },
        {
          "x": 400,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName} Setup ${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName} ${version} portable.${ext}"
    },
    "afterPack": "scripts/after-pack.js",
    "fileAssociations": [
      {
        "ext": "ptn",
        "name": "Deposition Pattern",
        "description": "Inkjet deposition pattern",
        "role": "Editor"
      }
    ],
    "publish": null
  }
}
